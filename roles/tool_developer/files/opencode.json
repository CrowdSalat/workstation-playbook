{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/ws": "allow",
      "~/ws/**": "allow",
      "/Projects": "allow",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
